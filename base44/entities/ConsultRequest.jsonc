{
  "name": "ConsultRequest",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string",
      "description": "Patient (animal) name"
    },
    "global_patient_id": {
      "type": "string",
      "description": "Reference to GlobalPatient entity ID"
    },
    "patient_case_number": {
      "type": "string",
      "description": "Hospital case / patient ID number"
    },
    "species": {
      "type": "string",
      "enum": [
        "Canine",
        "Feline",
        "Equine",
        "Bovine",
        "Avian",
        "Exotic",
        "Other"
      ],
      "description": "Species"
    },
    "breed": {
      "type": "string",
      "description": "Breed"
    },
    "age_years": {
      "type": "number",
      "description": "Age in years"
    },
    "sex": {
      "type": "string",
      "enum": [
        "Female Spayed",
        "Female Intact",
        "Male Neutered",
        "Male Intact"
      ],
      "description": "Sex / reproductive status"
    },
    "weight_kg": {
      "type": "number",
      "description": "Weight in kg"
    },
    "reason_for_consult": {
      "type": "string",
      "description": "Clinical reason for the consult request"
    },
    "requesting_service": {
      "type": "string",
      "description": "Service submitting the consult"
    },
    "requesting_clinician": {
      "type": "string",
      "description": "Name of the clinician requesting the consult"
    },
    "consulting_service": {
      "type": "string",
      "description": "Service receiving the consult (auto-populated from on_consults)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ],
      "default": "pending",
      "description": "Current consult status"
    },
    "consult_date": {
      "type": "string",
      "format": "date",
      "description": "Date the consult was requested"
    }
  },
  "required": [
    "patient_name",
    "reason_for_consult",
    "requesting_service",
    "requesting_clinician"
  ]
}