{
  "name": "JournalComment",
  "type": "object",
  "properties": {
    "journal_id": {
      "type": "string",
      "description": "Reference to Journal entity ID"
    },
    "comment": {
      "type": "string",
      "description": "Comment text"
    },
    "author_email": {
      "type": "string",
      "description": "Email of comment author"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of comment author"
    }
  },
  "required": [
    "journal_id",
    "comment"
  ]
}