{
  "name": "SurgicalLogEntry",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "description": "Hospital case / patient ID number"
    },
    "surgery_date": {
      "type": "string",
      "format": "date",
      "description": "Date of surgery (DD/MM/YYYY display, stored as ISO date)"
    },
    "service": {
      "type": "string",
      "description": "Service performing the surgery"
    },
    "species": {
      "type": "string",
      "enum": [
        "Canine",
        "Feline",
        "Porcine",
        "Equine",
        "Caprine",
        "Bovine",
        "Other"
      ],
      "description": "Species of the patient"
    },
    "laterality": {
      "type": "string",
      "enum": [
        "N/A",
        "Left",
        "Right",
        "Bilateral"
      ],
      "description": "Laterality of the procedure"
    },
    "procedure": {
      "type": "string",
      "description": "Surgical procedure performed"
    },
    "diagnosis": {
      "type": "string",
      "description": "Diagnosis / indication for surgery"
    },
    "primary_surgeon": {
      "type": "string",
      "description": "Name of the primary surgeon"
    },
    "emergency": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was an emergency surgery"
    },
    "residents_scrubbed_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of resident names/IDs scrubbed into the procedure"
    },
    "residents_count": {
      "type": "number",
      "description": "Number of residents scrubbed in"
    },
    "faculty_present": {
      "type": "string",
      "description": "Faculty member present"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the surgery"
    },
    "logged_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who have personally logged this procedure"
    },
    "global_patient_id": {
      "type": "string",
      "description": "Reference to GlobalPatient entity ID"
    },
    "patient_visit_id": {
      "type": "string",
      "description": "Reference to the most recent open PatientVisit entity ID at time of surgery"
    }
  },
  "required": [
    "case_number",
    "surgery_date",
    "species",
    "laterality",
    "procedure"
  ]
}